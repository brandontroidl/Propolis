# =============================================================================
# Propolis CONTROL-PLANE environment
# Covers two separate real files on a control-plane box:
#   /etc/propolis/propolis.env  - loaded by deploy/propolis.service (unified
#                                  daemon: intake + review + feed + console +
#                                  fetch + VT + ops-alert)
#   /etc/propolis/gateway.env   - loaded by deploy/gateway.service (mTLS ingest
#                                  from disposable collectors)
# Each section below is labeled with which file it belongs in.
# =============================================================================
#
# SP-A (collector/control-plane split): this is the CONTROL-PLANE surface -
# the box that holds DATABASE_URL, every vendor/VT key, and the console
# password. It is never exposed directly to attacker traffic; the only
# untrusted-adjacent surface it runs is gateway.service's mTLS listener, which
# accepts connections only from collectors presenting a certificate signed by
# the configured CA (see deploy/gateway.service and crates/gateway). The setup
# procedure, including what no script does for you, is docs/operations/split-deployment.md.
#
# Never commit a filled-in copy of this file: it carries secrets (DB URL, API
# keys, console password, mTLS key paths). Copy the relevant sections into
# /etc/propolis/propolis.env and /etc/propolis/gateway.env and fill in there.
# Every example address below uses an RFC 5737 / RFC 1918 documentation range.

# =============================================================================
# /etc/propolis/gateway.env - deploy/gateway.service
# crates/gateway/src/config.rs is authoritative.
# =============================================================================

# Bind address (REQUIRED, single ip:port). No compiled-in default - the
# gateway fails closed if unset:
PROPOLIS_GATEWAY_BIND=0.0.0.0:9443

# mTLS material (REQUIRED, all three), under the names provision-certs writes.
# The CA cert verifies each collector's client certificate; the server cert/key
# are what the gateway presents to collectors (its name must equal
# PROPOLIS_SHIPPER_GATEWAY_DNS on every collector). The key must be 0600 and
# owned by propolis-gateway; the certificates are not secret (0644):
PROPOLIS_GATEWAY_CA_CERT_PATH=/etc/propolis/certs/ca.crt
PROPOLIS_GATEWAY_SERVER_CERT_PATH=/etc/propolis/certs/gateway.crt
PROPOLIS_GATEWAY_SERVER_KEY_PATH=/etc/propolis/certs/gateway.key

# Where accepted batches are spooled, one events.jsonl PER COLLECTOR under
# this root (<root>/<collector_id>/events.jsonl, collector_id taken from the
# verified client certificate CommonName - crates/gateway/src/spool.rs). See
# the "Intake re-point" section below for how the control plane consumes it.
# PROPOLIS_GATEWAY_SPOOL_DIR=/var/spool/propolis/gateway
# Each collector's position in its batch chain, <dir>/<collector_id>.json
# (last_seq, last_batch_hash - crates/gateway/src/state.rs). The gateway reads
# a file only when it first sees the collector after startup, so deleting one
# takes effect at the next restart, and then stops that collector's shipper
# until the shipper's state is reset too; see the runbook.
# gateway.service can write only to these two default paths, so leave both
# unset:
# PROPOLIS_GATEWAY_STATE_DIR=/var/lib/propolis/gateway

# Connection bounds (same ConnectionBounds shape sensors use). Only
# MAX_CONCURRENT and MAX_DURATION_SECS take effect: READ_TIMEOUT_MS and
# IDLE_TIMEOUT_MS are validated but not applied by the gateway yet.
# PROPOLIS_GATEWAY_MAX_CONCURRENT=64
# PROPOLIS_GATEWAY_MAX_DURATION_SECS=120
# PROPOLIS_GATEWAY_READ_TIMEOUT_MS=30000
# PROPOLIS_GATEWAY_IDLE_TIMEOUT_MS=60000

# Without this the gateway logs errors only, and a healthy gateway prints
# nothing at all:
RUST_LOG=info

# =============================================================================
# /etc/propolis/propolis.env - deploy/propolis.service (unified daemon)
# =============================================================================

# -----------------------------------------------------------------------------
# Database (required)
# -----------------------------------------------------------------------------
DATABASE_URL=postgres://propolis:CHANGE_ME@localhost:5432/propolis
# PROPOLIS_DB_MAX_CONNECTIONS=10

# -----------------------------------------------------------------------------
# Intake - RE-POINTED at the gateway's per-collector spool (SP-A)
# -----------------------------------------------------------------------------
# IMPORTANT: the gateway spools ONE events.jsonl PER COLLECTOR, not per sensor
# (a collector may run several sensors, and their events interleave into that
# one file - each JSONL line still carries its own "sensor" field, which is
# what scoring actually keys on). So PROPOLIS_SENSOR_LOGS on the control plane
# is re-pointed from local sensor log paths to per-collector gateway spool
# paths, one name:path entry PER COLLECTOR:
#
#   PROPOLIS_SENSOR_LOGS=collector-01:/var/spool/propolis/gateway/collector-01/events.jsonl
#
# The "name" here (collector-01) labels this tailer in intake's logs and in the
# sensor-down and intake-stalled alerts. It never keys the cursor (that is the
# path) and is never matched against an event's own "sensor" field.
# intake's per-line handling does not require name == event.sensor; it parses
# each line's "sensor" field independently for scoring, regardless of which
# file (which collector) the line was tailed from. One entry per collector is
# therefore correct even though each collector may run many sensors.
#
# This example shows a SINGLE collector (collector-01), which is all the
# shipped tooling supports: provision-certs creates a new CA on every run,
# issues one collector certificate from it and never writes the CA's private
# key, so no run can issue a certificate for a second collector under an
# existing CA, and no shipped procedure covers enrolling more:
PROPOLIS_SENSOR_LOGS=collector-01:/var/spool/propolis/gateway/collector-01/events.jsonl
# PROPOLIS_CURSOR_DIR=/var/lib/propolis/cursors
# PROPOLIS_QUARANTINE_DIR=/var/lib/propolis/quarantine
# PROPOLIS_POLL_INTERVAL_MS=1000

# -----------------------------------------------------------------------------
# Review, vendor enrichment, VirusTotal, malware fetcher, ops-alerting, feed,
# and the operator console: UNCHANGED by SP-A - these stay control-plane-only,
# exactly as documented in deploy/propolis.env.example (same variables, same
# defaults, same fail-closed rules). Copy the relevant sections from that file
# below this line. Vendor/VT/console are never present on a collector box -
# see deploy/collector.env.example's header for why that boundary matters.
# -----------------------------------------------------------------------------
# PROPOLIS_REVIEW_ENABLED=true
# PROPOLIS_QUEUE_SCAN_INTERVAL_SECS=60
# PROPOLIS_SUBMIT_POLL_INTERVAL_SECS=30
#
# PROPOLIS_VENDOR_ABUSEIPDB_ENABLED=false
# PROPOLIS_VENDOR_ABUSEIPDB_KEY=
# PROPOLIS_VENDOR_DSHIELD_ENABLED=false
# PROPOLIS_VENDOR_DSHIELD_KEY=
# PROPOLIS_VENDOR_DSHIELD_USER=
# PROPOLIS_VENDOR_OTX_ENABLED=false
# PROPOLIS_VENDOR_OTX_KEY=
#
# PROPOLIS_VT_ENABLED=false
# PROPOLIS_VT_KEY=
#
# PROPOLIS_FETCH_ENABLED=false
# PROPOLIS_FETCH_OWN_IPS=
#
# PROPOLIS_OPS_ENABLED=false
# PROPOLIS_OPS_NTFY_URL=https://ntfy.sh
# PROPOLIS_OPS_NTFY_TOPIC=
#
# PROPOLIS_FEED_ENABLED=true
# PROPOLIS_FEED_OUTPUT_DIR=/var/lib/propolis/feed/current
#
# PROPOLIS_CONSOLE_BIND=127.0.0.1:8080
# PROPOLIS_CONSOLE_PASSWORD=
# PROPOLIS_CONSOLE_SESSION_SECRET=
#
# See deploy/propolis.env.example for the full, authoritative list of every
# variable in this section (defaults, bounds, and fail-closed behavior).
