[Unit]
Description=Propolis DNS honeypot sensor
After=network.target

# Answers DNS over UDP and TCP on PROPOLIS_DNS_BIND (both, or the sensor refuses to start) and,
# when PROPOLIS_DNS_TLS_BIND is set, DNS over TLS. It serves no records: every query gets REFUSED
# with the question echoed and nothing appended, so a UDP reply is never larger than the query
# that caused it and a spoofed query cannot be reflected at a victim with any gain. Off until an
# operator creates /etc/propolis/dns.env with PROPOLIS_DNS_BIND. Bind the public address, not
# 0.0.0.0, on a host whose own resolver stub already listens on port 53.

[Service]
Type=simple
User=propolis-dns
Group=propolis-dns
EnvironmentFile=/etc/propolis/dns.env
ExecStart=/usr/local/bin/sensor-dns
Restart=always
RestartSec=10

NoNewPrivileges=yes
ProtectSystem=strict
ProtectHome=yes
PrivateTmp=yes
PrivateDevices=yes
ProtectKernelTunables=yes
ProtectControlGroups=yes
RestrictAddressFamilies=AF_INET AF_INET6
ReadWritePaths=/var/log/propolis/dns
# Per-sensor cert and key for PROPOLIS_DNS_TLS_CERT / PROPOLIS_DNS_TLS_KEY; read-only. The
# leading "-" lets the unit start where the directory is absent (TLS unused); a configured pair
# that cannot be read still refuses to start in-process.
ReadOnlyPaths=-/etc/propolis/tls

# 53 and 853 are privileged.
AmbientCapabilities=CAP_NET_BIND_SERVICE
CapabilityBoundingSet=CAP_NET_BIND_SERVICE

MemoryMax=256M
TasksMax=128
CPUQuota=50%
LimitNOFILE=4096

SystemCallFilter=@system-service
SystemCallFilter=~@privileged @resources
SystemCallArchitectures=native
MemoryDenyWriteExecute=yes

ProtectClock=yes
ProtectKernelLogs=yes
ProtectKernelModules=yes
ProtectHostname=yes
RestrictNamespaces=yes
RestrictSUIDSGID=yes
RestrictRealtime=yes
LockPersonality=yes
RemoveIPC=yes
ProtectProc=invisible
ProcSubset=pid
UMask=0027

[Install]
WantedBy=multi-user.target
