# =============================================================================
# Propolis DISPOSABLE COLLECTOR environment
# One file per collector box, e.g. /etc/propolis/collector.env, split across the
# per-unit env files below (each sensor keeps its own /etc/propolis/<sensor>.env,
# the shipper gets /etc/propolis/shipper.env) - see deploy/shipper.service and
# each deploy/sensor-*.service for which file each unit actually loads.
# =============================================================================
#
# SP-A (collector/control-plane split): this is the DISPOSABLE-COLLECTOR
# surface. A collector box runs the attacker-facing sensors plus the shipper
# that forwards their logs to the control-plane gateway over mTLS. It is
# designed to be rebuilt/rotated cheaply if an attacker fingerprints or
# compromises it.
#
# THIS FILE (and every real /etc/propolis/*.env file on a collector box) MUST
# NEVER CONTAIN A CENTRAL SECRET:
#   - no DATABASE_URL (the collector never talks to PostgreSQL - see
#     deploy/control-plane.env.example instead)
#   - no PROPOLIS_VT_* / PROPOLIS_VENDOR_* keys (vendor enrichment is a
#     control-plane-only concern)
#   - no PROPOLIS_CONSOLE_* (the operator console never runs on a collector)
# A compromised or captured collector box exposes only its own mTLS client
# certificate (scoped to one gateway, one collector identity, revocable) and
# whatever sensors it runs - never the database, vendor API keys, or the
# console password. That boundary is the entire point of the split; do not
# widen this file to close the gap "just this once."
#
# Every example address below uses an RFC 5737 / RFC 1918 documentation range.
# Replace with your real values; never commit a filled-in copy of this file.

# -----------------------------------------------------------------------------
# Sensors (PROPOLIS_<SENSOR>_*)
# -----------------------------------------------------------------------------
# Unchanged from a single-box deployment - see deploy/sensor.env.example for the
# full per-sensor variable reference (bind, WAN map, timeouts, spool dir, etc.)
# and deploy/sensor-*.service for which env file each sensor unit loads. Sensors
# write their JSONL event logs locally on this collector box
# (/var/log/propolis/<sensor>/events.jsonl by default); the shipper below tails
# those same paths and forwards them - it does not change where sensors write.
#
# Concrete example (one sensor shown; repeat per sensor with its own prefix
# and /etc/propolis/<sensor>.env file):
#
# /etc/propolis/ssh.env:
# PROPOLIS_SSH_BIND=0.0.0.0:22
# PROPOLIS_SSH_WAN_MAP=192.168.1.5=198.51.100.7
# PROPOLIS_SSH_LOG_PATH=/var/log/propolis/ssh/events.jsonl

# -----------------------------------------------------------------------------
# Shipper (PROPOLIS_SHIPPER_*) - /etc/propolis/shipper.env
# Loaded by deploy/shipper.service. Tails this collector's sensor logs and
# ships batches to the control-plane gateway over mutual TLS.
# crates/shipper/src/config.rs is authoritative.
# -----------------------------------------------------------------------------

# Gateway address (REQUIRED, host:port). Points at the control-plane box's
# gateway.service bind address:
PROPOLIS_SHIPPER_GATEWAY_ADDR=203.0.113.10:9443
# DNS name the gateway's TLS server certificate presents (REQUIRED - checked
# during the mTLS handshake, independent of the IP dialed above):
PROPOLIS_SHIPPER_GATEWAY_DNS=gateway.example.invalid

# mTLS material (REQUIRED, all three). Placeholder paths only - provision the
# real PEM files out of band, mode 0600, owned by propolis-shipper:
PROPOLIS_SHIPPER_CA_CERT_PATH=/etc/propolis/certs/ca.pem
PROPOLIS_SHIPPER_CLIENT_CERT_PATH=/etc/propolis/certs/collector-01-client.pem
PROPOLIS_SHIPPER_CLIENT_KEY_PATH=/etc/propolis/certs/collector-01-client.key

# This collector's identity (REQUIRED). MUST match the CommonName baked into
# the client certificate above - the shipper refuses to start otherwise
# (crates/shipper/src/config.rs::validate_collector_id). The gateway trusts
# this id from the verified certificate CN, never from anything the collector
# sends in the payload:
PROPOLIS_SHIPPER_COLLECTOR_ID=collector-01

# Sensor logs this shipper tails (REQUIRED), same name:path,name:path grammar
# as the control plane's PROPOLIS_SENSOR_LOGS. The name is a free-form label
# recorded per-batch for cursor keying and logging only - it is NOT the
# per-event sensor field (that travels inside each JSONL record already).
# Every sensor log on this collector ships through the ONE seq/hash chain the
# gateway keys by this collector's certificate CN, regardless of how many
# name:path entries are listed here:
PROPOLIS_SHIPPER_SENSOR_LOGS=ssh:/var/log/propolis/ssh/events.jsonl,telnet:/var/log/propolis/telnet/events.jsonl,catchall:/var/log/propolis/catchall/events.jsonl

# Where per-log tail cursors and shipper state are persisted (so a restart
# resumes, not replays or re-ships):
# PROPOLIS_SHIPPER_CURSOR_DIR=/var/lib/propolis/shipper/cursors
# PROPOLIS_SHIPPER_STATE_DIR=/var/lib/propolis/shipper/state

# How often the shipper polls sensor logs for new lines:
# PROPOLIS_SHIPPER_POLL_INTERVAL_MS=1000
# Max records per batch frame (bounded by the wire protocol's frame-safe
# ceiling - do not raise past what crates/shipper/src/batcher.rs's
# MAX_RECORDS_FRAME_SAFE allows without also re-deriving that constant):
# PROPOLIS_SHIPPER_MAX_RECORDS_PER_BATCH=15
# Backoff before retrying a failed batch send:
# PROPOLIS_SHIPPER_RETRY_BACKOFF_MS=2000
