# Nightly backup of this node (deploy/backup.sh, installed as /usr/local/sbin/propolis-backup),
# driven by propolis-backup.timer. upgrade.sh runs the same script with --reason pre-upgrade before
# it installs anything.
#
# Runs as root: the archive reads every sensor's 0750 spool, /etc/propolis's 0600 env files and the
# SSH host key. The sandbox below lets it write only the backup directory and its status files.
# Idle I/O and CPU priority, because the dump reads the whole ledger and must not slow intake.
# The daemon's backup-stale alert reads /var/lib/propolis/backup-status/last-success; a failed run
# writes last-failure there and exits non-zero (visible in `systemctl --failed`).
[Unit]
OnFailure=propolis-alert@%n.service
Description=Back up the Propolis database and state
Documentation=file:///usr/local/sbin/propolis-backup
After=postgresql.service

[Service]
Type=oneshot
ExecStart=/usr/local/sbin/propolis-backup --reason scheduled
Nice=19
IOSchedulingClass=idle
CPUSchedulingPolicy=idle
# A dump of a ledger in the tens of millions of rows takes a while; this only stops a hung one.
TimeoutStartSec=6h

ProtectSystem=strict
ReadWritePaths=/var/backups/propolis /var/lib/propolis/backup-status
ProtectHome=yes
PrivateTmp=yes
PrivateDevices=yes
NoNewPrivileges=yes
ProtectKernelTunables=yes
ProtectKernelModules=yes
ProtectKernelLogs=yes
ProtectControlGroups=yes
ProtectClock=yes
ProtectHostname=yes
# AF_UNIX and AF_INET/AF_INET6: PostgreSQL over its socket or over TCP, as DATABASE_URL says.
RestrictAddressFamilies=AF_UNIX AF_INET AF_INET6
RestrictNamespaces=yes
RestrictRealtime=yes
RestrictSUIDSGID=yes
LockPersonality=yes
MemoryDenyWriteExecute=yes
SystemCallArchitectures=native
# Executable: the script, `propolis pg-exec` (which execs pg_dump and psql by PATH; the script
# runs pg_restore itself), the distro tools the script runs (bash, tar, age, sha256sum, flock,
# df, du and the rest, under /usr/bin on a merged-/usr system) and their libraries. On Debian
# and Ubuntu, postgresql-client-common ships /usr/bin/pg_dump, psql and pg_restore as symlinks
# to /usr/share/postgresql-common/pg_wrapper, a Perl script that then execs the real binary
# from /usr/lib/postgresql/<N>/bin; the kernel's noexec check runs on the mount holding the
# resolved target, not the symlink, so the wrapper is named here as well (with "-": Fedora's
# postgresql package has no wrapper, and an absent unprefixed path fails the unit). The list
# assumes the distro's own PostgreSQL client packages: PGDG packages on RHEL and Fedora install
# under /usr/pgsql-<N>/bin with alternatives symlinks in /usr/bin, outside it. Nothing else: the
# spools and /etc/propolis it archives hold captured samples, and age or any other tool must
# come from the distro package, not /usr/local/bin. This unit runs as root, which could undo a
# mount, so the mount syscalls are filtered out as systemd.exec(5) advises for these
# directives; nothing the script runs mounts anything.
NoExecPaths=/
ExecPaths=/usr/local/sbin/propolis-backup /usr/local/bin/propolis /usr/bin -/usr/share/postgresql-common/pg_wrapper /usr/lib -/usr/lib64
SystemCallFilter=~@mount
