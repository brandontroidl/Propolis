[Unit]
Description=Propolis MQTT honeypot sensor
After=network.target

# Metadata-only recon trap for TCP/1883: records CONNECT credentials, SUBSCRIBE topics and PUBLISH
# metadata, and never delivers, retains or forwards a message. Off until an operator creates
# /etc/propolis/mqtt.env with PROPOLIS_MQTT_BIND: without it the sensor refuses to start.
# Port 1883 is unprivileged, so this unit deliberately grants no CAP_NET_BIND_SERVICE; an operator
# who binds a port below 1024 must add the capability to a drop-in.

[Service]
Type=simple
User=propolis-mqtt
Group=propolis-mqtt
EnvironmentFile=/etc/propolis/mqtt.env
ExecStart=/usr/local/bin/sensor-mqtt
Restart=always
RestartSec=10

NoNewPrivileges=yes
ProtectSystem=strict
ProtectHome=yes
PrivateTmp=yes
PrivateDevices=yes
ProtectKernelTunables=yes
ProtectControlGroups=yes
RestrictAddressFamilies=AF_INET AF_INET6
ReadWritePaths=/var/log/propolis/mqtt

CapabilityBoundingSet=

MemoryMax=256M
TasksMax=128
CPUQuota=50%
LimitNOFILE=4096

SystemCallFilter=@system-service
SystemCallFilter=~@privileged @resources
SystemCallArchitectures=native
MemoryDenyWriteExecute=yes

ProtectClock=yes
ProtectKernelLogs=yes
ProtectKernelModules=yes
ProtectHostname=yes
RestrictNamespaces=yes
RestrictSUIDSGID=yes
RestrictRealtime=yes
LockPersonality=yes
RemoveIPC=yes
ProtectProc=invisible
ProcSubset=pid
UMask=0027

[Install]
WantedBy=multi-user.target
