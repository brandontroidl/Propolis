[Unit]
Description=Propolis TFTP honeypot sensor
After=network.target

# One of two sensors that answer over UDP (sensor-dns is the other). Replies are bounded in code (bytes sent never exceed
# bytes received from the peer; reads are never served; no retransmission), so a spoofed request
# cannot be reflected at a victim with any gain. Off until an operator creates
# /etc/propolis/tftp.env with PROPOLIS_TFTP_BIND: without it the sensor binds nothing and exits.
# Open inbound UDP/69 only on hosts that are meant to run it.

[Service]
Type=simple
User=propolis-tftp
Group=propolis-tftp
EnvironmentFile=/etc/propolis/tftp.env
ExecStart=/usr/local/bin/sensor-tftp
Restart=always
RestartSec=10

NoNewPrivileges=yes
ProtectSystem=strict
ProtectHome=yes
PrivateTmp=yes
PrivateDevices=yes
ProtectKernelTunables=yes
ProtectControlGroups=yes
RestrictAddressFamilies=AF_INET AF_INET6
ReadWritePaths=/var/log/propolis/tftp /var/spool/propolis/tftp

AmbientCapabilities=CAP_NET_BIND_SERVICE
CapabilityBoundingSet=CAP_NET_BIND_SERVICE

# PROPOLIS_TFTP_CAPTURE_MEMORY_BYTES (env file) defaults to 40% of this value. If MemoryMax is
# changed, set that variable too, or the capture ceiling stays at the 256M-derived default.
MemoryMax=256M
TasksMax=128
CPUQuota=50%
LimitNOFILE=4096

SystemCallFilter=@system-service
SystemCallFilter=~@privileged @resources
SystemCallArchitectures=native
MemoryDenyWriteExecute=yes

ProtectClock=yes
ProtectKernelLogs=yes
ProtectKernelModules=yes
ProtectHostname=yes
RestrictNamespaces=yes
RestrictSUIDSGID=yes
RestrictRealtime=yes
LockPersonality=yes
RemoveIPC=yes
ProtectProc=invisible
ProcSubset=pid
UMask=0027

[Install]
WantedBy=multi-user.target
