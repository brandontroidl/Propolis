# Shell functions as an interactive login bash on Ubuntu 22.04 runs them. Definition and call, the
# arguments and the `return` status, `local` scope, a function shadowing a command, `type` and
# `command -v`/`-V` of a function with bash's own listing of the body, `unset -f`, `export -f`,
# FUNCNAME and FUNCNEST. Each reply was produced by `bash --noprofile --norc --noediting -i`
# started as a login shell (`exec -a -bash`) in the localhost/propolis-survey-ref:jammy container
# (bash 5.1.16, dash 0.5.11), run with `--network none`, PS1 and PS2 set to markers and these
# lines fed one at a time on standard input. The lines that run `sh` ran dash as /bin/sh.
# The unlimited recursion that kills bash with a stack overflow is not recorded, because the
# reference shell ends there; the emulator's limit on it is covered by its unit tests.
# source: ubuntu:22.04 container run of bash 5.1.16 and dash 0.5.11 (synthetic command shapes)
# date: 2026-10-09
# protocol: ssh
# persona: ubuntu
$ f() { echo hi; }
$ f
> hi
$ echo $?
> 0
$ f() { echo "n=$# 1=$1 2=$2 at=$@ zero=$0"; }
$ set -- x y z
$ f a b
> n=2 1=a 2=b at=a b zero=-bash
$ echo "after n=$# 1=$1 at=$@"
> after n=3 1=x at=x y z
$ f() { return 3; }
$ f; echo $?
> 3
$ g() { false; return; }
$ g; echo $?
> 1
$ h() { true; return; }
$ h; echo $?
> 0
$ f() { return 300; }; f; echo $?
> 44
$ f() { return -1; }; f; echo $?
> 255
$ f() { return abc; }; f; echo $?
> -bash: return: abc: numeric argument required
> 2
$ f() { return 3 4; echo cont; }; f; echo reached
> -bash: return: too many arguments
$ echo next
> next
$ return 4
> -bash: return: can only `return' from a function or sourced script
$ echo "after rc=$?"
> after rc=2
$ ls() { echo mine; }
$ ls
> mine
$ \ls
> mine
