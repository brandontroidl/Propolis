# =============================================================================
# Propolis sensor environment (per-sensor)
# One env file per sensor unit, e.g. /etc/propolis/ssh.env for sensor-ssh.service
# =============================================================================
#
# Every attacker-facing sensor runs as its own systemd unit with its own env
# file. The variables below are shown with the SSH prefix as a concrete example;
# the same shape applies to every sensor - just swap the prefix (table below).
# Defaults shown are the real code defaults and are shared across the TCP shell
# sensors unless noted.
#
# All sensors FAIL CLOSED on a missing/invalid bind: no sensor has a compiled-in
# default port, so *_BIND (or CATCHALL_BIND_ADDRS / the cred per-protocol binds)
# MUST be set or the sensor refuses to start. The IP portion is yours to choose
# (0.0.0.0, a specific address, 127.0.0.1); the ports below are only the
# conventional ones a deploy typically uses.

# ---- Per-sensor prefix -> unit / conventional port -------------------------
#   PROPOLIS_SSH_*      sensor-ssh       22
#   PROPOLIS_TELNET_*   sensor-telnet    23
#   PROPOLIS_HTTP_*     sensor-http      80
#   PROPOLIS_FTP_*      sensor-ftp       21   (also opens dynamic PASV data ports)
#   PROPOLIS_SMTP_*     sensor-smtp      25
#   PROPOLIS_REDIS_*    sensor-redis     6379
#   PROPOLIS_ADB_*      sensor-adb       5555
#   CATCHALL_*          sensor-catchall  (multi TCP+UDP; see below)
#   PROPOLIS_CRED_*     sensor-cred      (5 protocols; see below)
# ---------------------------------------------------------------------------

# ---- Impersonated hostname (persona; set per host so the fleet is not uniform)
# Read by every sensor. Unset = a built-in default hostname.
# PROPOLIS_HOSTNAME=

# =============================================================================
# Example: sensor-ssh  (/etc/propolis/ssh.env)
# =============================================================================

# Bind address (REQUIRED, single ip:port). Fails closed if unset/unparseable.
PROPOLIS_SSH_BIND=0.0.0.0:22

# WAN attribution (optional): map the local bind to the PUBLIC address recorded
# on events, comma-separated local_ip=wan_ip. Without it, events from this
# sensor record wan_ip = NULL (which degrades breadth scoring). NOTE: there is a
# separate *_WAN_MAP per sensor - set it on EVERY sensor, not just one.
# PROPOLIS_SSH_WAN_MAP=10.0.0.5=198.51.100.7

# Where this sensor writes its JSONL event log (must match PROPOLIS_SENSOR_LOGS
# in propolis.env so intake tails the same path).
# PROPOLIS_SSH_LOG_PATH=/var/log/propolis/ssh/events.jsonl

# Timeouts and per-connection caps (shared defaults across the shell sensors):
# PROPOLIS_SSH_READ_TIMEOUT_MS=30000
# PROPOLIS_SSH_IDLE_TIMEOUT_MS=60000
# PROPOLIS_SSH_MAX_DURATION_SECS=600
# PROPOLIS_SSH_MAX_CAPTURED_BYTES=1000000
# PROPOLIS_SSH_MAX_CONCURRENT=256

# SSH-only extras:
# Presented SSH banner. Set per host so the fleet does not share one fingerprint.
# PROPOLIS_SSH_BANNER=SSH-2.0-OpenSSH_9.6p1 Ubuntu-3ubuntu13
# PROPOLIS_SSH_HOST_KEY_PATH=/var/lib/propolis/ssh/host_key
# Captured-upload quarantine spool (also on adb/ftp/catchall):
# PROPOLIS_SSH_SPOOL_DIR=/var/spool/propolis/ssh

# Other sensors: replace the SSH_ prefix and drop the SSH-only extras. The
# capture sensors (ssh, telnet, adb, ftp, catchall) also take a *_SPOOL_DIR; the
# rest do not. Conventional binds: TELNET 0.0.0.0:23, HTTP 0.0.0.0:80, FTP
# 0.0.0.0:21, SMTP 0.0.0.0:25, REDIS 0.0.0.0:6379, ADB 0.0.0.0:5555.
#
# sensor-telnet also spools a capture, but only when the shell phase sees a
# binary payload (a Mirai/Gafgyt dropper) - never the login/password phase and
# never a plaintext-only session:
# PROPOLIS_TELNET_SPOOL_DIR=/var/spool/propolis/telnet

# =============================================================================
# sensor-catchall  (/etc/propolis/catchall.env)  - note the CATCHALL_ prefix
# =============================================================================
# Comma-separated list of ip:port binds; BOTH TCP and UDP are attempted per
# entry. A per-port bind failure is non-fatal (logged, sensor stays up); an
# empty list fails closed. REQUIRED.
# CATCHALL_BIND_ADDRS=0.0.0.0:1024,0.0.0.0:8081,0.0.0.0:3389
# CATCHALL_WAN_MAP=10.0.0.5=198.51.100.7
# CATCHALL_LOG_PATH=/var/log/propolis/catchall/events.jsonl
# CATCHALL_READ_TIMEOUT_MS=30000
# CATCHALL_IDLE_TIMEOUT_MS=60000
# CATCHALL_MAX_DURATION_SECS=600
# CATCHALL_MAX_CAPTURED_BYTES=1000000
# CATCHALL_MAX_CONCURRENT=256

# =============================================================================
# sensor-cred  (/etc/propolis/cred.env)  - one process, 5 credential protocols
# =============================================================================
# Each protocol has its own bind; AT LEAST ONE must be set (fail closed if none).
# PROPOLIS_CRED_VNC_BIND=0.0.0.0:5900
# PROPOLIS_CRED_MYSQL_BIND=0.0.0.0:3306
# PROPOLIS_CRED_MSSQL_BIND=0.0.0.0:1433
# PROPOLIS_CRED_PG_BIND=0.0.0.0:5432
# PROPOLIS_CRED_MONGO_BIND=0.0.0.0:27017
# PROPOLIS_CRED_WAN_MAP=10.0.0.5=198.51.100.7
# Per-protocol JSONL logs are written under this directory (vnc.jsonl, etc.):
# PROPOLIS_CRED_LOG_DIR=/var/log/propolis/cred
# PROPOLIS_CRED_READ_TIMEOUT_MS=30000
# PROPOLIS_CRED_IDLE_TIMEOUT_MS=60000
# PROPOLIS_CRED_MAX_DURATION_SECS=600
# PROPOLIS_CRED_MAX_CAPTURED_BYTES=1000000
# PROPOLIS_CRED_MAX_CONCURRENT=256
