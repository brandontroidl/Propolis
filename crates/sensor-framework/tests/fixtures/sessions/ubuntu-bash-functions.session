> ls: cannot access '/nonexistent_dir': No such file or directory
> rc=2
$ unset -f ls
$ echo() { printf 'mine %s\n' "$*"; }
$ echo hi
> mine hi
$ command echo hi
> hi
$ builtin echo hi
> hi
$ unset -f echo
$ cd() { echo mine; }; cd /tmp; echo $?
> mine
> 0
$ unset -f cd
$ f() { echo hi; } >/tmp/shfn_o
$ f; echo --; cat /tmp/shfn_o; f; cat /tmp/shfn_o
> --
> hi
> hi
