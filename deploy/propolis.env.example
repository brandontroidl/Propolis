# =============================================================================
# Propolis platform environment (aggregated `propolis` daemon)
# Loaded by propolis.service as /etc/propolis/propolis.env
# =============================================================================
#
# This is the env for the AGGREGATED single-node binary `propolis`, which runs
# intake + review + feed + the console web server + the outbound fetcher +
# VirusTotal scanner + ops-alerting in one process. Sensors are NOT configured
# here - each sensor runs as its own systemd unit with its own env file (see
# sensor.env.example).
#
# Conventions in this file:
#   - Lines shown UNCOMMENTED are required or commonly set.
#   - Lines shown COMMENTED (`# KEY=...`) show the built-in DEFAULT; uncomment to
#     override. Every value here is the real code default.
#   - Booleans accept: true/false, 1/0, yes/no, on/off.
#   - Every guard fails CLOSED: an unset or malformed value denies/disables,
#     never silently admits.
#
# Never commit a filled-in copy of this file: it carries secrets (DB URL, API
# keys, console password). Copy to /etc/propolis/propolis.env and fill in there.

# -----------------------------------------------------------------------------
# Database (required)
# -----------------------------------------------------------------------------
DATABASE_URL=postgres://propolis:CHANGE_ME@localhost:5432/propolis
# Connection pool size.
# PROPOLIS_DB_MAX_CONNECTIONS=10

# -----------------------------------------------------------------------------
# Intake (tails each sensor's JSONL event log into Postgres)
# -----------------------------------------------------------------------------
# Comma-separated name:path pairs, one per sensor log to ingest. The name is a
# free-form label recorded on each event. Must match where your sensors write
# (see each sensor's *_LOG_PATH / CATCHALL_LOG_PATH / PROPOLIS_CRED_LOG_DIR).
PROPOLIS_SENSOR_LOGS=catchall:/var/log/propolis/catchall/events.jsonl,ssh:/var/log/propolis/ssh/events.jsonl,telnet:/var/log/propolis/telnet/events.jsonl,redis:/var/log/propolis/redis/events.jsonl,adb:/var/log/propolis/adb/events.jsonl,http:/var/log/propolis/http/events.jsonl,ftp:/var/log/propolis/ftp/events.jsonl,smtp:/var/log/propolis/smtp/events.jsonl,cred-vnc:/var/log/propolis/cred/vnc.jsonl,cred-mysql:/var/log/propolis/cred/mysql.jsonl,cred-mssql:/var/log/propolis/cred/mssql.jsonl,cred-pg:/var/log/propolis/cred/postgresql.jsonl,cred-mongo:/var/log/propolis/cred/mongodb.jsonl
# Where per-log tail cursors are persisted (so a restart resumes, not replays).
# PROPOLIS_CURSOR_DIR=/var/lib/propolis/cursors
# How often intake polls each log file for new lines.
# PROPOLIS_POLL_INTERVAL_MS=1000

# -----------------------------------------------------------------------------
# Review (scores IPs, runs the gatekeeper, feeds the review queue)
# -----------------------------------------------------------------------------
# PROPOLIS_REVIEW_ENABLED=true
# PROPOLIS_QUEUE_SCAN_INTERVAL_SECS=60
# PROPOLIS_SUBMIT_POLL_INTERVAL_SECS=30

# -----------------------------------------------------------------------------
# Threat-intel vendor enrichment (AbuseIPDB / DShield / OTX)
# Each vendor is OFF unless *_ENABLED=true AND a key is set (fail-closed: an
# enabled vendor with an empty key is treated as disabled). URLs default to the
# real vendor endpoints - only override for a proxy or a test double.
# -----------------------------------------------------------------------------
# AbuseIPDB (free account at abuseipdb.com):
PROPOLIS_VENDOR_ABUSEIPDB_ENABLED=false
PROPOLIS_VENDOR_ABUSEIPDB_KEY=
# PROPOLIS_VENDOR_ABUSEIPDB_URL=https://api.abuseipdb.com
# PROPOLIS_VENDOR_ABUSEIPDB_COOLDOWN_HOURS=24
# PROPOLIS_VENDOR_ABUSEIPDB_RATE_LIMIT=100
# PROPOLIS_VENDOR_ABUSEIPDB_RATE_WINDOW_HOURS=1

# DShield / SANS ISC (free account at dshield.org; needs BOTH user and key):
PROPOLIS_VENDOR_DSHIELD_ENABLED=false
PROPOLIS_VENDOR_DSHIELD_KEY=
PROPOLIS_VENDOR_DSHIELD_USER=
# PROPOLIS_VENDOR_DSHIELD_URL=https://www.dshield.org
# PROPOLIS_VENDOR_DSHIELD_COOLDOWN_HOURS=24
# PROPOLIS_VENDOR_DSHIELD_RATE_LIMIT=100
# PROPOLIS_VENDOR_DSHIELD_RATE_WINDOW_HOURS=1

# AlienVault OTX (free account at otx.alienvault.com):
PROPOLIS_VENDOR_OTX_ENABLED=false
PROPOLIS_VENDOR_OTX_KEY=
# PROPOLIS_VENDOR_OTX_URL=https://otx.alienvault.com
# PROPOLIS_VENDOR_OTX_COOLDOWN_HOURS=24
# PROPOLIS_VENDOR_OTX_RATE_LIMIT=100
# PROPOLIS_VENDOR_OTX_RATE_WINDOW_HOURS=1

# -----------------------------------------------------------------------------
# VirusTotal sample scanning (OFF by default)
# Scans SPOOLED samples by SHA-256 hash-LOOKUP (sends only the hash). Enabling
# also requires a key. VT_UPLOAD additionally UPLOADS unknown sample bytes to VT
# - leave false unless you intend to publish captured samples (uploading a
# targeted sample can tip the actor and may leak victim data).
# -----------------------------------------------------------------------------
PROPOLIS_VT_ENABLED=false
PROPOLIS_VT_KEY=
# PROPOLIS_VT_UPLOAD=false
# PROPOLIS_VT_SCAN_INTERVAL_SECS=300

# -----------------------------------------------------------------------------
# Malware fetcher (OFF by default)
# Retrieves samples from download URLs attackers stage (HTTP/TFTP only, not scp),
# through an SSRF guard + size/hop/rate caps, into the quarantine spool.
# On a NAT'd node you MUST set PROPOLIS_FETCH_OWN_IPS to this node's public
# egress IP(s) or the self-target guard cannot exclude your own address.
# -----------------------------------------------------------------------------
PROPOLIS_FETCH_ENABLED=false
# Public egress IP(s) of this node, comma-separated (REQUIRED behind NAT):
PROPOLIS_FETCH_OWN_IPS=
# PROPOLIS_FETCH_INTERVAL_SECS=10            # 1..=86400
# PROPOLIS_FETCH_MAX_BYTES=10000000          # per file; max 500000000
# PROPOLIS_FETCH_MAX_PER_HOST_HOUR=12        # max 1000
# PROPOLIS_FETCH_MAX_HOPS=3                   # redirect hops
# PROPOLIS_FETCH_MAX_DEPTH=2                  # nested-fetch depth
# PROPOLIS_FETCH_DAILY_CAP=200                # max 10000
# PROPOLIS_FETCH_BATCH_SIZE=20                # max 1000
# PROPOLIS_FETCH_CONNECT_TIMEOUT_SECS=10      # max 300
# PROPOLIS_FETCH_READ_TIMEOUT_SECS=10         # max 300
# PROPOLIS_FETCH_TOTAL_TIMEOUT_SECS=30        # max 300
# PROPOLIS_FETCH_USER_AGENT=Wget/1.21.3

# -----------------------------------------------------------------------------
# Operational alerting (OFF by default)
# Dead-man's-switch + health monitor that pages via ntfy. When enabled, a NTFY
# URL and TOPIC are mandatory (fail-closed: a monitor that cannot page is worse
# than a loud config error).
# -----------------------------------------------------------------------------
PROPOLIS_OPS_ENABLED=false
PROPOLIS_OPS_NTFY_URL=https://ntfy.sh
PROPOLIS_OPS_NTFY_TOPIC=
# Optional bearer token if your ntfy server requires auth:
# PROPOLIS_OPS_NTFY_TOKEN=
# PROPOLIS_OPS_POLL_INTERVAL_SECS=30
# PROPOLIS_OPS_REPAGE_COOLDOWN_SECS=5400      # 90 min between repages
# PROPOLIS_OPS_STALL_FOR_SECS=600             # alert if intake stalls this long
# PROPOLIS_OPS_CAPACITY_FREE_PCT=15           # alert below this DB-pool headroom (1..=100)
# PROPOLIS_OPS_FEED_STALE_MULTIPLE=2          # feed stale if age > N x build interval
# PROPOLIS_OPS_VENDOR_WINDOW_SECS=3600        # vendor-failure sampling window
# PROPOLIS_OPS_VENDOR_FAIL_PCT=50             # alert above this fail rate (1..=100)
# PROPOLIS_OPS_VENDOR_MIN_SAMPLES=20          # min submissions before the rate matters
# PROPOLIS_OPS_BACKLOG_MAX=500                # review-queue backlog alert threshold
# PROPOLIS_OPS_BACKLOG_FOR_SECS=900           # ...sustained this long
# PROPOLIS_OPS_CHAIN_VERIFY_INTERVAL_SECS=21600  # hash-chain integrity re-check (6h)

# -----------------------------------------------------------------------------
# Blocklist feed publisher
# -----------------------------------------------------------------------------
# PROPOLIS_FEED_ENABLED=true
# PROPOLIS_FEED_OUTPUT_DIR=/var/lib/propolis/feed/current
# PROPOLIS_FEED_BUILD_INTERVAL_SECS=900
# Never-list your own infrastructure. CIDRs, comma-separated:
# PROPOLIS_FEED_ALLOWLIST=203.0.113.0/24,198.51.100.10/32
# Suppress whole networks by ASN (e.g. 8075 Microsoft, 15169 Google, 13335 Cloudflare):
# PROPOLIS_FEED_ASN_ALLOWLIST=8075,15169,13335
# Force-remove specific IPs from the feed, comma-separated:
# PROPOLIS_FEED_DELIST=
# Rolling activity windows the feed publishes:
# PROPOLIS_FEED_WINDOWS=24h,7d,30d,60d,90d
# Per-tier time-to-live before an entry ages out:
# PROPOLIS_FEED_AGGRESSIVE_TTL_HOURS=24
# PROPOLIS_FEED_STANDARD_TTL_HOURS=48

# -----------------------------------------------------------------------------
# Operator console (web UI + /health /ready /metrics)
# -----------------------------------------------------------------------------
# Default binds LOOPBACK only; front it with a TLS reverse proxy. The console
# speaks plain HTTP (no in-process TLS), so binding 0.0.0.0 exposes credentials
# in cleartext unless a proxy or firewall protects the port.
# PROPOLIS_CONSOLE_BIND=127.0.0.1:8080
# Operator login password (REQUIRED; the console refuses to start without it):
PROPOLIS_CONSOLE_PASSWORD=
# 64 hex chars (32 bytes). If unset, a fresh random secret is generated at each
# start (which invalidates existing sessions on restart). Set it to keep
# sessions stable across restarts:
# PROPOLIS_CONSOLE_SESSION_SECRET=
# Reverse-DNS enrichment of attacker IPs in the console (outbound DNS):
# PROPOLIS_CONSOLE_RDNS_ENABLED=false

# -----------------------------------------------------------------------------
# GeoIP (optional)
# -----------------------------------------------------------------------------
# Directory containing MaxMind GeoLite2 .mmdb files (local reads, no network).
# Unset = no geo enrichment.
# PROPOLIS_GEOIP_DIR=/etc/propolis
