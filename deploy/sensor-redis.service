[Unit]
OnFailure=propolis-alert@%n.service
Description=Propolis Redis honeypot sensor
After=network.target

[Service]
Type=simple
User=propolis-redis
Group=propolis-redis
EnvironmentFile=/etc/propolis/redis.env
ExecStart=/usr/local/bin/sensor-redis
Restart=always
RestartSec=10

NoNewPrivileges=yes
ProtectSystem=strict
ProtectHome=yes
PrivateTmp=yes
PrivateDevices=yes
ProtectKernelTunables=yes
ProtectControlGroups=yes
RestrictAddressFamilies=AF_INET AF_INET6
ReadWritePaths=/var/log/propolis/redis
# Per-sensor cert and key for PROPOLIS_REDIS_TLS_CERT / PROPOLIS_REDIS_TLS_KEY; read-only. The
# leading "-" lets the unit start where the directory is absent (TLS unused); a configured pair
# that cannot be read still refuses to start in-process.
ReadOnlyPaths=-/etc/propolis/tls
# Nothing on the filesystem is executable except this sensor's own binary and the shared
# libraries it loads (libc, libm, libgcc_s and the loader, under /usr/lib or /usr/lib64). The
# sensor execs nothing, so a captured upload or spool entry cannot run here even on a mount that
# lost its noexec option. See deploy/sensor-ssh.service for the full reasoning.
NoExecPaths=/
ExecPaths=/usr/local/bin/sensor-redis /usr/lib /usr/lib64
CapabilityBoundingSet=

MemoryMax=256M
TasksMax=128
CPUQuota=50%
LimitNOFILE=4096

SystemCallFilter=@system-service
SystemCallFilter=~@privileged @resources
SystemCallArchitectures=native
MemoryDenyWriteExecute=yes

ProtectClock=yes
ProtectKernelLogs=yes
ProtectKernelModules=yes
ProtectHostname=yes
RestrictNamespaces=yes
RestrictSUIDSGID=yes
RestrictRealtime=yes
LockPersonality=yes
RemoveIPC=yes
ProtectProc=invisible
ProcSubset=pid
UMask=0027

[Install]
WantedBy=multi-user.target
