# How Ubuntu 22.04's bash prints a function back (`type f`). bash does not echo the definition: it
# prints the command it parsed, in its own layout (four spaces a level, `;` and a newline between
# commands, `elif` as a nested `else if`, a `function` keyword in front of a function defined
# inside another, here-documents after the line that holds them, a pipeline's second stage on a
# line indented by two after a here-document). Every shape below is one the emulator rebuilds from
# its syntax tree. Each reply was produced by `bash --noprofile --norc --noediting -i` started as
# a login shell (`exec -a -bash`) in the localhost/propolis-survey-ref:jammy container (bash
# 5.1.16), run with `--network none`, PS1 and PS2 set to markers and these lines fed one at a time
# on standard input. Lines of the listing that end in a blank are written with `\x20`, which an
# editor cannot strip.
# source: ubuntu:22.04 container run of bash 5.1.16 (synthetic command shapes)
# date: 2026-10-09
# protocol: ssh
# persona: ubuntu
$ f() { A=1 B="two words" cmd -x 'q q' "d d" $v ${v:-x} $(sub) `bt` $((1+2)) ~/x; }
$ type f
> f is a function
>e f ()\x20
>e {\x20
>     A=1 B="two words" cmd -x 'q q' "d d" $v ${v:-x} $(sub) `bt` $((1+2)) ~/x
> }
$ f() { echo a >f; echo b >>f; cat <f; echo c 2>f; echo d 2>&1; echo e >&2; cat <&3; echo g >|f; cat <>f; echo h 3>f 4>>g; }
$ type f
> f is a function
>e f ()\x20
>e {\x20
>     echo a > f;
>     echo b >> f;
>     cat < f;
>     echo c 2> f;
>     echo d 2>&1;
>     echo e 1>&2;
>     cat 0<&3;
>     echo g >| f;
>     cat 0<> f;
>     echo h 3> f 4>> g
> }
