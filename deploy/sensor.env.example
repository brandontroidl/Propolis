# =============================================================================
# Propolis sensor environment (per-sensor)
# One env file per sensor unit, e.g. /etc/propolis/ssh.env for sensor-ssh.service
# =============================================================================
#
# Every attacker-facing sensor runs as its own systemd unit with its own env
# file. The variables below are shown with the SSH prefix as a concrete example;
# the same shape applies to every sensor - just swap the prefix (table below).
# Defaults shown are the real code defaults and are shared across the TCP shell
# sensors unless noted.
#
# All sensors FAIL CLOSED on a missing/invalid bind: no sensor has a compiled-in
# default port, so *_BIND (or CATCHALL_BIND_ADDRS / the cred per-protocol binds)
# MUST be set or the sensor refuses to start. The IP portion is yours to choose
# (0.0.0.0, a specific address, 127.0.0.1); the ports below are only the
# conventional ones a deploy typically uses.

# ---- Per-sensor prefix -> unit / conventional port -------------------------
#   PROPOLIS_SSH_*      sensor-ssh       22
#   PROPOLIS_TELNET_*   sensor-telnet    23
#   PROPOLIS_HTTP_*     sensor-http      80
#   PROPOLIS_FTP_*      sensor-ftp       21   (also opens dynamic PASV data ports)
#   PROPOLIS_SMTP_*     sensor-smtp      25
#   PROPOLIS_TFTP_*     sensor-tftp      69   (UDP; replies are bounded, see below)
#   PROPOLIS_MQTT_*     sensor-mqtt      1883
#   PROPOLIS_REDIS_*    sensor-redis     6379
#   PROPOLIS_ADB_*      sensor-adb       5555
#   CATCHALL_*          sensor-catchall  (multi TCP+UDP; see below)
#   PROPOLIS_CRED_*     sensor-cred      (5 protocols; see below)
# ---------------------------------------------------------------------------

# ---- Impersonated hostname (persona; set per host so the fleet is not uniform)
# Read by every sensor. Unset = a built-in default hostname.
# PROPOLIS_HOSTNAME=

# =============================================================================
# Example: sensor-ssh  (/etc/propolis/ssh.env)
# =============================================================================

# Bind address (REQUIRED, single ip:port). Fails closed if unset/unparseable.
PROPOLIS_SSH_BIND=0.0.0.0:22

# WAN attribution (optional): map the local bind to the PUBLIC address recorded
# on events, comma-separated local_ip=wan_ip. Without it, events from this
# sensor record wan_ip = NULL (which degrades breadth scoring). NOTE: there is a
# separate *_WAN_MAP per sensor - set it on EVERY sensor, not just one.
# PROPOLIS_SSH_WAN_MAP=10.0.0.5=198.51.100.7

# Where this sensor writes its JSONL event log (must match PROPOLIS_SENSOR_LOGS
# in propolis.env so intake tails the same path).
# PROPOLIS_SSH_LOG_PATH=/var/log/propolis/ssh/events.jsonl

# Timeouts and per-connection caps (shared defaults across the shell sensors):
# PROPOLIS_SSH_READ_TIMEOUT_MS=30000
# PROPOLIS_SSH_IDLE_TIMEOUT_MS=60000
# PROPOLIS_SSH_MAX_DURATION_SECS=600
# PROPOLIS_SSH_MAX_CAPTURED_BYTES=1000000
# PROPOLIS_SSH_MAX_CONCURRENT=256

# SSH-only extras:
# Presented SSH banner. Set per host so the fleet does not share one fingerprint.
# PROPOLIS_SSH_BANNER=SSH-2.0-OpenSSH_9.6p1 Ubuntu-3ubuntu13
# PROPOLIS_SSH_HOST_KEY_PATH=/var/lib/propolis/ssh/host_key
# Captured-upload quarantine spool (also on adb/ftp/telnet, the other
# CaptureHandoff body-capturers - catchall spools no file bodies and has no
# such variable):
# PROPOLIS_SSH_SPOOL_DIR=/var/spool/propolis/ssh
# Outbox manifest directory (also on adb/ftp/telnet): defaults to
# <PROPOLIS_SSH_SPOOL_DIR>/outbox, so it always lands inside the writable spool
# root this unit's systemd ReadWritePaths grants. Override only to relocate it
# elsewhere within that same grant.
# PROPOLIS_SSH_OUTBOX_DIR=/var/spool/propolis/ssh/outbox
# Ceiling on capture bodies held in memory across every session (also
# PROPOLIS_{FTP,ADB,TELNET,TFTP,MQTT}_CAPTURE_MEMORY_BYTES). Unset takes 40% of the
# unit's MemoryMax: 214748364 for ssh (512M), 107374182 for the 256M sensors.
# Set it only together with a changed MemoryMax; zero or garbage refuses to start.
# PROPOLIS_SSH_CAPTURE_MEMORY_BYTES=214748364

# This collector's identity (also on adb/ftp/telnet, and on shipper's own
# collector.env.example): unset defaults to "local". Stamped onto every outbox
# manifest row this sensor writes, and MUST equal the same value shipper is
# configured with (its PROPOLIS_COLLECTOR_ID there) - a later stage joins on
# (collector_id, occurrence_id), so a mismatch here silently breaks
# attribution. The bare COLLECTOR_ID and shipper's old
# PROPOLIS_SHIPPER_COLLECTOR_ID spellings are still read as deprecated
# aliases; write new configs with PROPOLIS_COLLECTOR_ID.
# PROPOLIS_COLLECTOR_ID=local

# Other sensors: replace the SSH_ prefix and drop the SSH-only extras. The
# body-capturing sensors (ssh, telnet, adb, ftp) also take a *_SPOOL_DIR and a
# *_OUTBOX_DIR; catchall does not (it spools no file bodies). Conventional
# binds: TELNET 0.0.0.0:23, HTTP 0.0.0.0:80, FTP 0.0.0.0:21, SMTP 0.0.0.0:25,
# REDIS 0.0.0.0:6379, ADB 0.0.0.0:5555.
#
# sensor-telnet also spools a capture, but only when the shell phase sees a
# binary payload (a Mirai/Gafgyt dropper) - never the login/password phase and
# never a plaintext-only session:
# PROPOLIS_TELNET_SPOOL_DIR=/var/spool/propolis/telnet
#
# sensor-http (/etc/propolis/http.env) also serves HTTPS (implicit TLS) from the
# same process, but only when PROPOLIS_HTTP_TLS_BIND is set. The cert and key are
# the pair deploy/provision-tls.sh mints; the key must be mode 0600. Setting only
# one of CERT/KEY, or a TLS_BIND without both, or an unusable pair, refuses to
# start. CERT and KEY without a TLS_BIND load and validate the pair, start no
# TLS listener, and log one warning. TLS events carry "tls": true. Port 443 is
# privileged, which the unit's CAP_NET_BIND_SERVICE already covers.
# PROPOLIS_HTTP_TLS_BIND=0.0.0.0:443
# PROPOLIS_HTTP_TLS_CERT=/etc/propolis/tls/http.crt
# PROPOLIS_HTTP_TLS_KEY=/etc/propolis/tls/http.key
#
# sensor-redis (/etc/propolis/redis.env) also serves Redis over implicit TLS
# (rediss://) from the same process, but only when PROPOLIS_REDIS_TLS_BIND is set.
# The cert and key are the pair deploy/provision-tls.sh mints; the key must be mode
# 0600. Setting only one of CERT/KEY, or a TLS_BIND without both, or an unusable
# pair, refuses to start. CERT and KEY without a TLS_BIND load and validate the
# pair, start no TLS listener, and log one warning. TLS events carry "tls": true.
# Port 6380 is unprivileged, so the unit grants no capability.
# PROPOLIS_REDIS_TLS_BIND=0.0.0.0:6380
# PROPOLIS_REDIS_TLS_CERT=/etc/propolis/tls/redis.crt
# PROPOLIS_REDIS_TLS_KEY=/etc/propolis/tls/redis.key
#
# sensor-tftp (/etc/propolis/tftp.env) is the one UDP sensor that replies, and it
# is OFF until PROPOLIS_TFTP_BIND is set (e.g. 0.0.0.0:69); with no bind it binds
# nothing and exits. It takes the same *_WAN_MAP, *_LOG_PATH, *_SPOOL_DIR,
# *_OUTBOX_DIR and bound variables as the sensors above, with one difference:
# PROPOLIS_TFTP_MAX_CAPTURED_BYTES caps the retained upload body (default
# 1000000, at most 10000000; larger values are rejected at startup).
# Reads are never served (one tiny "File not found" error) and the bytes it
# sends never exceed the bytes it received, so it cannot amplify a spoofed
# request. Open inbound UDP/69 only where this sensor is meant to run.
# PROPOLIS_TFTP_BIND=0.0.0.0:69
#
# sensor-mqtt (/etc/propolis/mqtt.env) is OFF until PROPOLIS_MQTT_BIND is set
# (e.g. 0.0.0.0:1883); with no bind it refuses to start. It records CONNECT
# credentials (never the password), SUBSCRIBE topics and PUBLISH topic/payload
# metadata, and never delivers, retains or forwards a message. Like telnet, it
# spools a PUBLISH payload only when it looks binary (a dropped executable), never
# a plaintext one. Same *_WAN_MAP, *_LOG_PATH and bound variables as the sensors
# above.
# Port 1883 is unprivileged, so its unit grants no CAP_NET_BIND_SERVICE.
# PROPOLIS_MQTT_BIND=0.0.0.0:1883
# PROPOLIS_MQTT_SPOOL_DIR=/var/spool/propolis/mqtt
# PROPOLIS_MQTT_CAPTURE_MEMORY_BYTES=107374182
#
# sensor-mqtt also serves MQTTS (implicit TLS) from the same process, but only
# when PROPOLIS_MQTT_TLS_BIND is set. The cert and key are the pair
# deploy/provision-tls.sh mints; the key must be mode 0600. Setting only one of
# CERT/KEY, or a TLS_BIND without both, or an unusable pair, refuses to start.
# CERT and KEY without a TLS_BIND load and validate the pair, start no TLS
# listener, and log one warning. TLS events carry "tls": true. Binary PUBLISH
# spooling, the capture memory budget and the shutdown drain are shared with the
# plain listener. Port 8883 is unprivileged, so the unit grants no capability.
# PROPOLIS_MQTT_TLS_BIND=0.0.0.0:8883
# PROPOLIS_MQTT_TLS_CERT=/etc/propolis/tls/mqtt.crt
# PROPOLIS_MQTT_TLS_KEY=/etc/propolis/tls/mqtt.key
#
# sensor-smtp (/etc/propolis/smtp.env) takes PROPOLIS_SMTP_BIND (25) as above. With
# PROPOLIS_SMTP_TLS_CERT and PROPOLIS_SMTP_TLS_KEY set, STARTTLS upgrades the
# session on every plain listener (25 and the optional 587) instead of getting the
# unchanged 454 reply; without them the sensor behaves exactly as before. Two
# optional extra listeners exist only when their bind is set:
# PROPOLIS_SMTP_SUBMISSION_BIND (587, plain with STARTTLS) and
# PROPOLIS_SMTP_TLS_BIND (465, implicit TLS, SMTPS, which requires the cert and
# key). The cert and key are the pair deploy/provision-tls.sh mints; the key must
# be mode 0600. Setting only one of CERT/KEY, a TLS_BIND without both, an invalid
# bind, or an unusable pair refuses to start, before any bind. CERT and KEY
# without a TLS_BIND still enable STARTTLS and open no 465 listener. A bind
# failure on any listener stops the others and exits 1. TLS events carry
# "tls": true. Ports 25, 465 and 587 are privileged, which the unit's
# CAP_NET_BIND_SERVICE already covers.
# PROPOLIS_SMTP_SUBMISSION_BIND=0.0.0.0:587
# PROPOLIS_SMTP_TLS_BIND=0.0.0.0:465
# PROPOLIS_SMTP_TLS_CERT=/etc/propolis/tls/smtp.crt
# PROPOLIS_SMTP_TLS_KEY=/etc/propolis/tls/smtp.key
#
# sensor-ftp (/etc/propolis/ftp.env) takes PROPOLIS_FTP_BIND (21) as above. With
# PROPOLIS_FTP_TLS_CERT and PROPOLIS_FTP_TLS_KEY set, AUTH TLS upgrades the
# control channel on the plain listener (and FEAT, PBSZ and PROT are answered)
# instead of getting the unchanged 500 reply; without them the sensor behaves
# exactly as before. One optional extra listener exists only when its bind is set:
# PROPOLIS_FTP_TLS_BIND (990, implicit FTPS, which requires the cert and key).
# The cert and key are the pair deploy/provision-tls.sh mints; the key must be
# mode 0600. Setting only one of CERT/KEY, a TLS_BIND without both, an invalid
# bind, or an unusable pair refuses to start, before any bind. CERT and KEY
# without a TLS_BIND still enable AUTH TLS and open no 990 listener. A bind
# failure on any listener stops the others and exits 1. Events from a session
# whose control channel is TLS carry "tls": true. Passive data ports are
# unchanged; PROT P wraps them in TLS. Ports 21 and 990 are privileged, which the
# unit's CAP_NET_BIND_SERVICE already covers.
# PROPOLIS_FTP_TLS_BIND=0.0.0.0:990
# PROPOLIS_FTP_TLS_CERT=/etc/propolis/tls/ftp.crt
# PROPOLIS_FTP_TLS_KEY=/etc/propolis/tls/ftp.key

# =============================================================================
# sensor-catchall  (/etc/propolis/catchall.env)
# =============================================================================
# Uses the same PROPOLIS_<SENSOR>_ prefix as every other sensor. The bare
# CATCHALL_* spelling this sensor originally shipped with is still read as a
# migration path (it logs a deprecation warning), but write new configs with
# the PROPOLIS_ prefix - the mismatch silently killed a real deployment.
# Comma-separated list of ip:port binds; BOTH TCP and UDP are attempted per
# entry. A per-port bind failure is non-fatal (logged, sensor stays up); an
# empty list fails closed. REQUIRED.
# PROPOLIS_CATCHALL_BIND_ADDRS=0.0.0.0:1024,0.0.0.0:8081,0.0.0.0:3389
# PROPOLIS_CATCHALL_WAN_MAP=10.0.0.5=198.51.100.7
# The compiled default log path is the RELATIVE `catchall-events.jsonl`, which
# lands in the working directory, and the unit grants write access only under
# /var/log/propolis/catchall. Set the full path below under the unit.
# PROPOLIS_CATCHALL_LOG_PATH=/var/log/propolis/catchall/events.jsonl
# The values below are the compiled defaults (crates/sensor-catchall/src/main.rs),
# much tighter than the shell sensors' because this sensor emulates nothing and
# only reads what a probe sends unprompted.
# PROPOLIS_CATCHALL_READ_TIMEOUT_MS=5000
# PROPOLIS_CATCHALL_IDLE_TIMEOUT_MS=5000
# PROPOLIS_CATCHALL_MAX_DURATION_SECS=30
# PROPOLIS_CATCHALL_MAX_CAPTURED_BYTES=4096
# PROPOLIS_CATCHALL_MAX_CONCURRENT=256

# =============================================================================
# sensor-cred  (/etc/propolis/cred.env)  - one process, 5 credential protocols
# =============================================================================
# Each protocol has its own bind; AT LEAST ONE must be set (fail closed if none).
# PROPOLIS_CRED_VNC_BIND=0.0.0.0:5900
# PROPOLIS_CRED_MYSQL_BIND=0.0.0.0:3306
# PROPOLIS_CRED_MSSQL_BIND=0.0.0.0:1433
# PROPOLIS_CRED_PG_BIND=0.0.0.0:5432
# PROPOLIS_CRED_MONGO_BIND=0.0.0.0:27017
# PROPOLIS_CRED_WAN_MAP=10.0.0.5=198.51.100.7
# Per-protocol JSONL logs are written under this directory (vnc.jsonl, etc.):
# PROPOLIS_CRED_LOG_DIR=/var/log/propolis/cred
# PROPOLIS_CRED_READ_TIMEOUT_MS=30000
# PROPOLIS_CRED_IDLE_TIMEOUT_MS=60000
# PROPOLIS_CRED_MAX_DURATION_SECS=60
# PROPOLIS_CRED_MAX_CAPTURED_BYTES=100000
# PROPOLIS_CRED_MAX_CONCURRENT=256
#
# TLS (default off) runs on the binds above: there is no TLS bind and no new
# port. With PROPOLIS_CRED_TLS_CERT and PROPOLIS_CRED_TLS_KEY set, postgresql
# answers an SSLRequest with S, mysql advertises CLIENT_SSL, mssql negotiates
# TLS inside TDS PRELOGIN for a client that asks for encryption (a client that
# offers ENCRYPT_OFF stays plaintext), and mongodb serves a client whose first
# two bytes are a TLS record header over TLS on its plaintext port. Plaintext
# clients keep working on every port; vnc is unchanged. One pair serves all
# four. The cert and key are the pair deploy/provision-tls.sh mints; the key
# must be mode 0600. Setting only one of CERT/KEY, a blank or non-UTF-8 value,
# or an unusable pair refuses to start, before any bind. Events from a TLS
# session carry "tls": true. A bind failure on one protocol is logged and that
# protocol skipped; the sensor exits 1 only if every configured bind fails.
# PROPOLIS_CRED_TLS_CERT=/etc/propolis/tls/cred.crt
# PROPOLIS_CRED_TLS_KEY=/etc/propolis/tls/cred.key
