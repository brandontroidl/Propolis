# =============================================================================
# Propolis DISPOSABLE COLLECTOR environment
# Not one file: its sections belong in the per-unit env files named below (each
# sensor keeps its own /etc/propolis/<sensor>.env, the shipper gets
# /etc/propolis/shipper.env) - see deploy/shipper.service and each
# deploy/sensor-*.service for which file each unit actually loads. The setup
# procedure is docs/operations/split-deployment.md.
# =============================================================================
#
# SP-A (collector/control-plane split): this is the DISPOSABLE-COLLECTOR
# surface. A collector box runs the attacker-facing sensors plus the shipper
# that forwards their logs to the control-plane gateway over mTLS. It is
# designed to be rebuilt/rotated cheaply if an attacker fingerprints or
# compromises it.
#
# THIS FILE (and every real /etc/propolis/*.env file on a collector box) MUST
# NEVER CONTAIN A CENTRAL SECRET:
#   - no DATABASE_URL (the collector never talks to PostgreSQL - see
#     deploy/control-plane.env.example instead)
#   - no PROPOLIS_VT_* / PROPOLIS_VENDOR_* keys (vendor enrichment is a
#     control-plane-only concern)
#   - no PROPOLIS_CONSOLE_* (the operator console never runs on a collector)
# A compromised or captured collector box exposes only its own mTLS client
# certificate (scoped to one CA and one collector identity; there is no
# revocation list, so cutting it off means a new CA on both hosts) and
# whatever sensors it runs - never the database, vendor API keys, or the
# console password. That boundary is the entire point of the split; do not
# widen this file to close the gap "just this once."
#
# Every example address below uses an RFC 5737 / RFC 1918 documentation range.
# Replace with your real values; never commit a filled-in copy of this file.

# -----------------------------------------------------------------------------
# Sensors (PROPOLIS_<SENSOR>_*)
# -----------------------------------------------------------------------------
# Unchanged from a single-box deployment - see deploy/sensor.env.example for the
# full per-sensor variable reference (bind, WAN map, timeouts, spool dir, etc.)
# and deploy/sensor-*.service for which env file each sensor unit loads. Sensors
# write their JSONL event logs locally on this collector box
# (/var/log/propolis/<sensor>/events.jsonl by default, except sensor-catchall,
# whose default is relative - set PROPOLIS_CATCHALL_LOG_PATH - and sensor-cred,
# which writes /var/log/propolis/cred/<protocol>.jsonl per protocol); the
# shipper below tails those same paths and forwards them - it does not change
# where sensors write.
#
# Concrete example (one sensor shown; repeat per sensor with its own prefix
# and /etc/propolis/<sensor>.env file):
#
# /etc/propolis/ssh.env:
# PROPOLIS_SSH_BIND=0.0.0.0:22
# PROPOLIS_SSH_WAN_MAP=192.168.1.5=198.51.100.7
# PROPOLIS_SSH_LOG_PATH=/var/log/propolis/ssh/events.jsonl

# -----------------------------------------------------------------------------
# Shipper (PROPOLIS_SHIPPER_*) - /etc/propolis/shipper.env
# Loaded by deploy/shipper.service. Tails this collector's sensor logs and
# ships batches to the control-plane gateway over mutual TLS.
# crates/shipper/src/config.rs is authoritative.
# -----------------------------------------------------------------------------

# Gateway address (REQUIRED, a literal ip:port - nothing is resolved, so a
# host name is refused at startup). Points at the control-plane box's
# gateway.service bind address:
PROPOLIS_SHIPPER_GATEWAY_ADDR=203.0.113.10:9443
# Name the gateway's TLS server certificate presents (REQUIRED - checked
# during the mTLS handshake, independent of the IP dialed above; it is never
# resolved, so it need not exist in DNS):
PROPOLIS_SHIPPER_GATEWAY_DNS=gateway.example.invalid

# mTLS material (REQUIRED, all three), under the names provision-certs writes.
# The key must be 0600 and owned by propolis-shipper; the certificates are not
# secret (0644):
PROPOLIS_SHIPPER_CA_CERT_PATH=/etc/propolis/certs/ca.crt
PROPOLIS_SHIPPER_CLIENT_CERT_PATH=/etc/propolis/certs/collector-01.crt
PROPOLIS_SHIPPER_CLIENT_KEY_PATH=/etc/propolis/certs/collector-01.key

# This collector's identity (REQUIRED). MUST match the CommonName baked into
# the client certificate above - the shipper refuses to start otherwise
# (crates/shipper/src/config.rs::validate_collector_id). Set the same value as
# PROPOLIS_COLLECTOR_ID in each of this box's body-capturing sensors (see
# deploy/sensor.env.example): today they only stamp it on their outbox manifest
# rows, which nothing reads yet, but a later stage will join the gateway's
# cert-derived collector id against them on (collector_id, occurrence_id).
# The gateway trusts this id from the verified certificate CN, never from
# anything the collector sends in the payload:
#
# PROPOLIS_COLLECTOR_ID / the client cert CN identifies this collector's
# evidence chain on the gateway (its monotonic seq + rolling batch hash, keyed
# by CN - crates/gateway/src/state.rs). Rebuilding or rotating a collector box
# MUST use a FRESH PROPOLIS_COLLECTOR_ID with a matching freshly-provisioned
# cert, OR the gateway's stored state for the OLD id must be reset first.
# Reusing an old PROPOLIS_COLLECTOR_ID with a reset/fresh shipper state (a
# rebuilt box with an empty STATE_DIR) is unsafe: the gateway still remembers
# the old chain's last confirmed seq, so it answers the rebuilt collector's
# first batch as a duplicate of one it already holds, and the shipper stops
# with a ChainDiverged error rather than let it be dropped. The one exception
# is a gateway that had accepted a single batch: then that first batch is
# dropped silently and the next is rejected. Resync via one of the two options
# above before restarting it; the runbook gives the reset steps.
#
# The old PROPOLIS_SHIPPER_COLLECTOR_ID name is still read as a deprecated
# alias when PROPOLIS_COLLECTOR_ID is unset; write new configs with the name
# below.
PROPOLIS_COLLECTOR_ID=collector-01

# Sensor logs this shipper tails (REQUIRED), same name:path,name:path grammar
# as the control plane's PROPOLIS_SENSOR_LOGS. The name only labels log lines:
# it is not sent to the gateway, each log's cursor is keyed by its path, and it
# is NOT the per-event sensor field (that travels inside each JSONL record).
# Every sensor log on this collector ships through the ONE seq/hash chain the
# gateway keys by this collector's certificate CN, regardless of how many
# name:path entries are listed here:
PROPOLIS_SHIPPER_SENSOR_LOGS=ssh:/var/log/propolis/ssh/events.jsonl,telnet:/var/log/propolis/telnet/events.jsonl,catchall:/var/log/propolis/catchall/events.jsonl

# Where per-log tail cursors and the chain state are persisted. A restart
# resumes from them; delivery is at least once, so a crash between the
# gateway's acknowledgement and the cursor write sends those lines again:
# PROPOLIS_SHIPPER_CURSOR_DIR=/var/lib/propolis/shipper/cursors
# PROPOLIS_SHIPPER_STATE_DIR=/var/lib/propolis/shipper/state

# How often the shipper polls sensor logs for new lines:
# PROPOLIS_SHIPPER_POLL_INTERVAL_MS=1000
# Max records per batch frame (bounded by the wire protocol's frame-safe
# ceiling - do not raise past what crates/shipper/src/batcher.rs's
# MAX_RECORDS_FRAME_SAFE allows without also re-deriving that constant):
# PROPOLIS_SHIPPER_MAX_RECORDS_PER_BATCH=15
# Wait before resending a batch the gateway answered with Retry (at most 5
# times in a row); a failed connection is retried on the next poll instead:
# PROPOLIS_SHIPPER_RETRY_BACKOFF_MS=2000

# Without this the shipper logs errors only:
RUST_LOG=info
